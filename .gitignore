.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Downloaded tools (Amiberry and anything else `make tools` fetches)
.tools/

# Licensed media: only the manifest and its lock are tracked
media/*
!media/manifest.toml
!media/manifest.lock.json

# Emulator run state and build products
build/
runs/
.coverage

# Where each media source is on this machine; .env.example is tracked
.env
