# Where your own copies of the licensed Amiga media are, one variable per
# source in media/manifest.toml. Copy this file to .env and fill in the
# folders; .env is ignored by git. Real environment variables override .env.
# `~` at the start of a path means your home directory.

# The 'Amiga Files' folder of an Amiga Forever installation (contains Shared/rom and Shared/adf)
AMIGA_FOREVER_DIR=

# The root of the AmigaOS 3.2 CD or download (contains ROM/, ADF/, NDK3.2/)
AMIGAOS32_DIR=

# A personal folder of other material (manuals, configurations)
AMIGA_COLLECTION_DIR=
